{
  "name": "Hello Extensions",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage", "webNavigation", "notifications"],
  "action": {
    "default_popup": "index.html",
    "default_icon": "lmlogo.png"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.png", "*.png", "*.svg", "*.pdf"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": ["http://localhost:3000/*", "https://leetcode.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
