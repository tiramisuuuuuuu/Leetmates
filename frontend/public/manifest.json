{
  "name": "Hello Extensions",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage"],
  "action": {
    "default_popup": "index.html",
    "default_icon": "lmlogo.png"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.png", "*.png", "*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
